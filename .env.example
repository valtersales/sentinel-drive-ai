# Sentinel Drive AI - environment variables (copy to .env and adjust)
# PostgreSQL
POSTGRES_DB=sentineldrive
POSTGRES_USER=sentineldrive
POSTGRES_PASSWORD=sentineldrive
POSTGRES_PORT=5432

# Backend (Spring Boot)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# AI service (Python)
AI_SERVICE_PORT=8000
# Backend URL for sending risk events (set in docker-compose for containers)
BACKEND_URL=http://backend:8080
# Video source: 0 = default camera, or URL (rtsp://, http://) or file path
VIDEO_SOURCE=0
# Detection thresholds
EAR_THRESHOLD=0.2
EAR_CLOSURE_SECONDS=0.5
# MAR: set between your closed (~0.14) and open (~0.18) values; e.g. 0.16
MAR_THRESHOLD=0.16
MAR_SUSTAINED_SECONDS=0.2
HEAD_POSE_TILT_THRESHOLD_DEG=25.0
# Retry when sending events to backend
BACKEND_RETRY_MAX=5
BACKEND_RETRY_BACKOFF_SEC=1.0
