# Sentinel Drive AI - environment variables (copy to .env and adjust)
# PostgreSQL
POSTGRES_DB=sentineldrive
POSTGRES_USER=sentineldrive
POSTGRES_PASSWORD=sentineldrive
POSTGRES_PORT=5432

# Backend (Spring Boot)
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# AI service (Python)
AI_SERVICE_PORT=8000

# Backend URL used by AI service to send events (default set in docker-compose)
# BACKEND_URL=http://backend:8080
